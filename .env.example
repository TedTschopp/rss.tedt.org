# Copy this file to .env and fill in your token
# cp .env.example .env

# Supported providers: github_models, openai.
PIPELINE_LLM_PROVIDER=github_models

# GitHub Models fallback/local provider.
GH_MODELS_TOKEN=your_github_models_token_here

# OpenAI provider. OPENAI_API_KEY is easiest locally. In GitHub Actions, prefer
# workload identity federation variables and let Actions provide its OIDC token.
OPENAI_API_KEY=
OPENAI_WIF_AUDIENCE=
OPENAI_IDENTITY_PROVIDER_ID=
OPENAI_SERVICE_ACCOUNT_ID=
OPENAI_WIF_CLIENT_ID=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional pipeline LLM pacing controls. Set the request cap to 0 to disable
# proactive fixed-window pacing while keeping retry/backoff behavior.
PIPELINE_LLM_RATE_LIMIT_REQUESTS_PER_WINDOW=20
PIPELINE_LLM_RATE_LIMIT_WINDOW_SEC=60
PIPELINE_LLM_RATE_LIMIT_MIN_INTERVAL_SEC=1
PIPELINE_OPENAI_RATE_LIMIT_REQUESTS_PER_MINUTE=60
PIPELINE_OPENAI_DAILY_REQUEST_CAP=0
PIPELINE_OPENAI_GLOBAL_DAILY_REQUEST_CAP=0
