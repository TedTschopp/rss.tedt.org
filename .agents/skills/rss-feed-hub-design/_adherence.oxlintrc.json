{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feeds/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: kind, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:essential|important|optional|tech-informational|tech-important|tech-transformational|healthy|warning|unknown)$/]",
        "message": "<Badge> kind must be one of 'essential' | 'important' | 'optional' | 'tech-informational' | 'tech-important' | 'tech-transformational' | 'healthy' | 'warning' | 'unknown'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|href|target|disabled|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, href, target, disabled, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|outline|outline-accent|outline-ink|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'outline' | 'outline-accent' | 'outline-ink' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|name|description|url|formats|status|items|previewLabel|style|key|ref|className|style|children)$/]",
        "message": "<FeedCard> doesn't accept that prop. Declared props: index, name, description, url, formats, status, items, previewLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|href|date|priority|tech|style|key|ref|className|style|children)$/]",
        "message": "<FeedItem> doesn't accept that prop. Declared props: title, href, date, priority, tech, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedItem'] > JSXAttribute[name.name='priority'] > Literal[value!=/^(?:essential|important|optional)$/]",
        "message": "<FeedItem> priority must be one of 'essential' | 'important' | 'optional'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedItem'] > JSXAttribute[name.name='tech'] > Literal[value!=/^(?:transformational|important|informational)$/]",
        "message": "<FeedItem> tech must be one of 'transformational' | 'important' | 'informational'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormatButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:format|href|size|style|key|ref|className|style|children)$/]",
        "message": "<FormatButton> doesn't accept that prop. Declared props: format, href, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormatButton'] > JSXAttribute[name.name='format'] > Literal[value!=/^(?:rss2|rss1|atom|json)$/]",
        "message": "<FormatButton> format must be one of 'rss2' | 'rss1' | 'atom' | 'json'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormatButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<FormatButton> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|defaultValue|onChange|placeholder|label|readOnly|copyable|size|type|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, defaultValue, onChange, placeholder, label, readOnly, copyable, size, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Input> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|meta|action|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: eyebrow, title, meta, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|entries|updated|style|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: status, entries, updated, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:healthy|warning|unknown|external)$/]",
        "message": "<StatusPill> status must be one of 'healthy' | 'warning' | 'unknown' | 'external'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: active, onClick, children, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
